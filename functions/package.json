{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "npm run build && node --test test/unit.cjs",
    "test:integration": "npm run build && node --test test/integration.cjs",
    "test:browser": "node --test test/queue-browser.cjs",
    "test:emulators": "npm run build && firebase emulators:exec --config ../firebase.json --project demo-sigo --only auth,firestore,storage \"node --test test/integration.cjs\"",
    "test:rules": "firebase emulators:exec --config ../firebase.test.json --project demo-sigo --only auth,firestore,storage \"node --test test/security-rules.test.cjs\"",
    "test:pwa": "node --test test/pwa-browser.cjs",
    "seed": "node scripts/seed-mock.cjs"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.1.0",
    "firebase-functions": "^5.0.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.19.0",
    "firebase-tools": "15.30.1",
    "playwright": "1.63.0",
    "typescript": "^5.0.0"
  },
  "private": true
}
