rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
   function signed() { return request.auth != null; }
   function activeUser() { return !exists(/databases/$(database)/documents/users/$(request.auth.uid)) || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true) == true; }
   function dev() { return signed() && activeUser() && exists(/databases/$(database)/documents/dev_roles/$(request.auth.uid)) && get(/databases/$(database)/documents/dev_roles/$(request.auth.uid)).data.get('isActive', false) == true; }
   function cmExists(c) { return signed() && exists(/databases/$(database)/documents/construtoras/$(c)/construtora_members/$(request.auth.uid)); }
   function cm(c) { return get(/databases/$(database)/documents/construtoras/$(c)/construtora_members/$(request.auth.uid)).data; }
   function activeConstrutora(c) { return get(/databases/$(database)/documents/construtoras/$(c)).data.get('isActive', true) == true; }
   function member(c) { return cmExists(c) && activeUser() && cm(c).get('isActive', false) == true && activeConstrutora(c); }
   function admin(c) { return member(c) && (cm(c).get('isAdmin', false) == true || cm(c).get('isOwner', false) == true || cm(c).get('role', '') == 'admin' || cm(c).get('role', '') == 'owner'); }
   function omExists(c,o) { return signed() && exists(/databases/$(database)/documents/construtoras/$(c)/obras/$(o)/members/$(request.auth.uid)); }
   function om(c,o) { return get(/databases/$(database)/documents/construtoras/$(c)/obras/$(o)/members/$(request.auth.uid)).data; }
   function activeObra(c,o) {
     let ob = get(/databases/$(database)/documents/construtoras/$(c)/obras/$(o));
     return ob == null || ob.data.get('isActive', true) == true;
   }
   function obraMember(c,o) { return member(c) && omExists(c,o) && om(c,o).get('isActive', false) == true && activeObra(c,o); }
   function obraAdmin(c,o) { return admin(c) || (obraMember(c,o) && (om(c,o).get('isAdmin',false) == true || om(c,o).get('isOwner',false) == true || om(c,o).get('role', '') == 'admin' || om(c,o).get('role', '') == 'owner')); }
   function module(c,o,m) { return obraAdmin(c,o) || (obraMember(c,o) && (m in om(c,o).get('modules',[]) || m == 'diario' && 'rdo' in om(c,o).get('modules',[]) || m == 'estoque' && 'almoxarifado' in om(c,o).get('modules',[]) || m == 'validacao' && 'qualidade' in om(c,o).get('modules',[]) || m == 'adm' && 'financeiro' in om(c,o).get('modules',[]))); }
   function stock(c) { return admin(c) || (member(c) && ('estoque' in cm(c).get('modules',[]) || 'almoxarifado' in cm(c).get('modules',[]))); }
   function rh(c) { return admin(c) || (member(c) && ('rh' in cm(c).get('modules',[]) || 'recursos_humanos' in cm(c).get('modules',[]))); }
   function epi(c) { return admin(c) || (member(c) && ('epi' in cm(c).get('modules',[]))); }
   function validacao(c) { return admin(c) || (member(c) && ('validacao' in cm(c).get('modules',[]) || 'qualidade' in cm(c).get('modules',[]))); }
   function adm(c) { return admin(c) || (member(c) && ('adm' in cm(c).get('modules',[]) || 'financeiro' in cm(c).get('modules',[]))); }

   // Acesso irrestrito total para desenvolvedores globais ativos
   match /{document=**} {
     allow read, write: if dev();
   }
  match /dev_roles/{uid} {
    allow read: if signed() && activeUser() && (request.auth.uid == uid || dev());
    allow create: if signed() && activeUser() && request.auth.uid == uid && (
      (exists(/databases/$(database)/documents/users/$(uid)) && get(/databases/$(database)/documents/users/$(uid)).data.get('globalRole', '') == 'dev') ||
      request.auth.token.email.matches('(?i).*dev.*')
    ) && request.resource.data.get('isActive', false) == true;
    allow update, delete: if dev();
  }
  match /audit/{id} { allow read: if dev(); allow write: if dev(); }
  match /users/{uid} {
   allow read: if signed() && activeUser() && (request.auth.uid == uid || dev());
   allow create: if signed() && activeUser() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['id','email','displayName','photoUrl','createdAt','updatedAt','globalRole','isActive']) && request.resource.data.id == uid && request.resource.data.email == request.auth.token.email && request.resource.data.get('globalRole','user') in ['user',null] && request.resource.data.get('isActive', true) == true;
   allow update: if signed() && activeUser() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','photoUrl','updatedAt']);
   allow delete: if dev();
  }
match /construtoras/{c} {
    allow read: if dev() || member(c);
    allow create: if dev() && request.resource.data.id == c;
    allow update: if admin(c) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','cnpj','address','logoUrl','updatedAt']) && (!('logoUrl' in request.resource.data) || request.resource.data.logoUrl == null || request.resource.data.logoUrl is string);
    allow delete: if dev();
    match /construtora_members/{uid} { allow read: if signed() && activeUser() && (request.auth.uid == uid || admin(c)); allow write: if dev(); }
   match /commands/{id} { allow read: if dev() || (signed() && activeUser() && resource.data.actor == request.auth.uid); allow write: if dev(); }
   match /funcionarios/{f} {
    allow read: if rh(c);
    allow create, update: if rh(c) && request.resource.data.id == f && request.resource.data.construtoraId == c;
    allow delete: if dev();
   }
   match /equipes/{e} {
    allow read: if member(c);
    allow create, update: if rh(c) && request.resource.data.id == e && request.resource.data.construtoraId == c;
    allow delete: if dev();
   }
   match /catalogo_epis/{epiId} {
    allow read: if member(c);
    allow create, update: if (admin(c) || epi(c)) && request.resource.data.id == epiId && request.resource.data.construtoraId == c;
    allow delete: if dev();
   }
   match /validacao_templates/{tId} {
    allow read: if member(c);
    allow create, update: if (admin(c) || validacao(c)) && request.resource.data.id == tId && request.resource.data.construtoraId == c;
    allow delete: if dev();
   }
   match /fornecedores/{fId} {
    allow read: if member(c);
    allow create: if (admin(c) || stock(c) || adm(c))
      && request.resource.data.id == fId
      && request.resource.data.construtoraId == c
      && request.resource.data.documento is string
      && (request.resource.data.documento.size() == 11 || request.resource.data.documento.size() == 14)
      && request.resource.data.status in ['ativo', 'inativo'];
    allow update: if (admin(c) || stock(c) || adm(c))
      && request.resource.data.id == fId
      && request.resource.data.construtoraId == c
      && request.resource.data.documento == resource.data.documento
      && request.resource.data.status in ['ativo', 'inativo'];
    allow delete: if dev();
   }
   match /materiais/{m} {
    allow read: if stock(c);
    allow create: if stock(c) && request.resource.data.keys().hasOnly(['id','construtoraId','name','unit','currentQuantity','quantityUnits','quantityScale','schemaVersion']) && request.resource.data.id == m && request.resource.data.construtoraId == c && request.resource.data.currentQuantity == 0 && request.resource.data.quantityUnits == 0 && request.resource.data.quantityScale == 1000 && request.resource.data.schemaVersion == 2;
    allow update: if admin(c) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','unit']);
    allow delete: if dev();
    match /movimentacoes/{id} { allow read: if stock(c); allow write: if dev(); }
   }
   match /despesas/{id} {
    allow read: if admin(c);
    allow create: if admin(c) && request.resource.data.keys().hasOnly(['id','construtoraId','obraId','descricao','valor','valorEmCentavos','dataVencimento','dataPagamento','status','categoria','responsavelId','createdAt','schemaVersion']) && request.resource.data.id == id && request.resource.data.construtoraId == c && request.resource.data.responsavelId == request.auth.uid && request.resource.data.status == 'pendente' && request.resource.data.dataPagamento == null && request.resource.data.valorEmCentavos is int && request.resource.data.valorEmCentavos > 0 && request.resource.data.valorEmCentavos <= 9007199254740991 && request.resource.data.valor == request.resource.data.valorEmCentavos / 100.0 && request.resource.data.schemaVersion == 2 && request.resource.data.dataVencimento is string && request.resource.data.dataVencimento.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && (request.resource.data.obraId == null || exists(/databases/$(database)/documents/construtoras/$(c)/obras/$(request.resource.data.obraId)));
    allow update, delete: if dev();
   }
   match /obras/{o} {
    allow read: if admin(c) || obraMember(c,o);
    allow create: if admin(c) && request.resource.data.id == o && request.resource.data.construtoraId == c;
    allow update: if (
      admin(c)
      && request.resource.data.id == resource.data.id
      && request.resource.data.construtoraId == resource.data.construtoraId
    ) || (
      obraAdmin(c,o)
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
      && request.resource.data.name is string
      && request.resource.data.name.size() > 0
      && request.resource.data.name.size() <= 200
    );
    allow delete: if dev();
    match /members/{uid} { allow read: if signed() && activeUser() && (request.auth.uid == uid || obraAdmin(c,o)); allow write: if dev(); }
    match /lotes/{l} {
     allow read: if module(c,o,'lotes') || module(c,o,'adm') || module(c,o,'financeiro') || obraMember(c,o) || admin(c);
     allow create, update: if obraAdmin(c,o) && request.resource.data.id == l && request.resource.data.obraId == o;
     allow delete: if dev();
     match /validacoes/{v} {
      allow read: if obraMember(c,o) || admin(c);
      allow create, update: if (module(c,o,'validacao') || validacao(c) || obraAdmin(c,o))
        && request.resource.data.id == v
        && request.resource.data.construtoraId == c
        && request.resource.data.obraId == o
        && request.resource.data.loteId == l;
      allow delete: if dev();
     }
     match /resumo_custos/{doc} {
      allow read: if admin(c) || obraMember(c,o);
      allow create, update: if (admin(c) || obraAdmin(c,o) || module(c,o,'adm') || adm(c) || module(c,o,'financeiro') || module(c,o,'rh') || module(c,o,'almoxarifado'));
      allow delete: if dev();
     }
    }
    match /resumo_custos/{doc} {
     allow read: if admin(c) || obraMember(c,o);
     allow create, update: if (admin(c) || obraAdmin(c,o) || module(c,o,'adm') || adm(c) || module(c,o,'financeiro') || module(c,o,'rh') || module(c,o,'almoxarifado'));
     allow delete: if dev();
    }
    match /compras/{compraId} {
     allow read: if admin(c) || obraMember(c,o);
     allow create: if (admin(c) || obraAdmin(c,o) || module(c,o,'compras') || module(c,o,'almoxarifado') || module(c,o,'adm') || adm(c))
       && request.resource.data.id == compraId
       && request.resource.data.construtoraId == c
       && request.resource.data.obraId == o
       && request.resource.data.totalCompraCents is int
       && request.resource.data.totalCompraCents > 0
       && request.resource.data.status in ['aberto', 'parcial', 'pago', 'cancelado'];
     allow update: if (admin(c) || obraAdmin(c,o) || module(c,o,'compras') || module(c,o,'almoxarifado') || module(c,o,'adm') || adm(c))
       && request.resource.data.id == compraId
       && request.resource.data.construtoraId == c
       && request.resource.data.obraId == o
       && request.resource.data.status in ['aberto', 'parcial', 'pago', 'cancelado'];
     allow delete: if dev();
    }
    match /diarios/{id} { allow read: if module(c,o,'diario'); allow write: if dev(); }
    match /chamadas/{ch} {
     allow read: if rh(c) || module(c,o,'rh') || module(c,o,'adm') || module(c,o,'financeiro') || obraAdmin(c,o);
     allow create: if (rh(c) || module(c,o,'rh'))
       && request.resource.data.id == ch
       && request.resource.data.construtoraId == c
       && request.resource.data.obraId == o
       && request.resource.data.schemaVersion == 1
       && (!('totalDayCostCents' in request.resource.data) || (request.resource.data.totalDayCostCents is int && request.resource.data.totalDayCostCents >= 0));
     allow update: if (rh(c) || module(c,o,'rh'))
       && request.resource.data.id == ch
       && request.resource.data.construtoraId == c
       && request.resource.data.obraId == o
       && request.resource.data.schemaVersion == 1
       && (!('totalDayCostCents' in request.resource.data) || (request.resource.data.totalDayCostCents is int && request.resource.data.totalDayCostCents >= 0))
       && (!('status' in resource.data) || (resource.data.status != 'fechada' && resource.data.status != 'confirmada') || request.resource.data.status == 'retificada')
       && (request.resource.data.status != 'retificada' || (request.resource.data.motivoRetificacao is string && request.resource.data.motivoRetificacao.size() >= 10));
     allow delete: if dev();
    }
    match /epi_events/{evId} {
     allow read: if admin(c) || obraMember(c,o);
     allow create, update: if (module(c,o,'epi') || epi(c))
       && request.resource.data.id == evId
       && request.resource.data.construtoraId == c
       && request.resource.data.obraId == o;
     allow delete: if dev();
    }
    match /termos_epi/{tId} {
     allow read: if admin(c) || obraMember(c,o);
     allow create, update: if (module(c,o,'epi') || epi(c))
       && request.resource.data.id == tId
       && request.resource.data.construtoraId == c
       && request.resource.data.obraId == o;
     allow delete: if dev();
    }
    match /despesas_adm/{dId} {
     allow read: if admin(c) || obraMember(c,o);
     allow create: if (admin(c) || obraAdmin(c,o) || module(c,o,'adm') || adm(c))
       && request.resource.data.id == dId
       && request.resource.data.construtoraId == c
       && request.resource.data.obraId == o
       && request.resource.data.valorTotalCents is int
       && request.resource.data.valorTotalCents > 0
       && request.resource.data.status in ['pendente', 'pago', 'atrasado', 'cancelado'];
     allow update: if (admin(c) || obraAdmin(c,o) || module(c,o,'adm') || adm(c))
       && request.resource.data.id == dId
       && request.resource.data.construtoraId == c
       && request.resource.data.obraId == o
       && (resource.data.status != 'pago' || request.resource.data.valorTotalCents == resource.data.valorTotalCents)
       && (request.resource.data.status != 'cancelado' || (request.resource.data.motivoCancelamento is string && request.resource.data.motivoCancelamento.size() >= 10));
     allow delete: if dev();
    }
   }
  }
   // --- Hierarquia estrutural (top-level): loteamentos > quadras > lotes > etapas > equipes
   // Escopo efetivo de obra: usa obraId (string não vazia) quando presente no loteamento (legado); caso contrário, fallback para o próprio id do loteamento.
   function hierarchyRead(c) { return admin(c) || (member(c) && 'lotes' in cm(c).get('modules', [])); }
   function hasExplicitObraId(data) {
     return data.get('obraId', null) is string && data.obraId.size() > 0;
   }
   function loteamentoObraId(data, id) {
     return hasExplicitObraId(data) ? data.obraId : id;
   }
   function effectiveHierarchyObra(c, l) {
     let lot = get(/databases/$(database)/documents/loteamentos/$(l));
     return lot != null
       && lot.data.get('construtoraId', '') == c
       && hasExplicitObraId(lot.data)
       ? lot.data.obraId
       : l;
   }
   function obraIsActive(c, o) {
     let obraDoc = get(/databases/$(database)/documents/construtoras/$(c)/obras/$(o));
     return obraDoc == null || obraDoc.data.get('isActive', true) == true;
   }
   function obraMemberActive(c, o) {
     let memberDoc = get(/databases/$(database)/documents/construtoras/$(c)/obras/$(o)/members/$(request.auth.uid));
     return member(c)
       && memberDoc != null
       && memberDoc.data.get('isActive', false) == true
       && obraIsActive(c, o);
   }
   function obraOnlyAdmin(c, o) {
     let memberDoc = get(/databases/$(database)/documents/construtoras/$(c)/obras/$(o)/members/$(request.auth.uid));
     return member(c)
       && memberDoc != null
       && memberDoc.data.get('isActive', false) == true
       && (memberDoc.data.get('isAdmin', false) == true
           || memberDoc.data.get('isOwner', false) == true
           || memberDoc.data.get('role', '') in ['admin', 'owner'])
       && obraIsActive(c, o);
   }
   function hierarchyObraMember(c, l) {
     return c is string && c.size() > 0 && l is string && l.size() > 0
       && obraMemberActive(c, effectiveHierarchyObra(c, l));
   }
   function hierarchyObraAdmin(c, l) {
     return c is string && c.size() > 0 && (
       admin(c)
       || (l is string && l.size() > 0 && obraOnlyAdmin(c, effectiveHierarchyObra(c, l)))
     );
   }
   function reqHierarchyId(data, field) {
     return field in data && data[field] is string && data[field].size() > 0 && data[field].size() <= 128;
   }
   function optHierarchyStr(data, field, maxLen) {
     return !(field in data) || data[field] == null || (data[field] is string && data[field].size() <= maxLen);
   }
   function optHierarchyStrUpdate(data, old, field, maxLen) {
     return optHierarchyStr(data, field, maxLen) || (field in old && data[field] == old[field]);
   }
   function isValidLoteamento(data, id) {
     return reqHierarchyId(data, 'construtoraId')
       && (!('id' in data) || (data.id is string && data.id == id))
       && (
         ('name' in data && data.name is string && data.name.size() > 0 && data.name.size() <= 200)
         || ('nome' in data && data.nome is string && data.nome.size() > 0 && data.nome.size() <= 200)
       )
       && optHierarchyStr(data, 'obraId', 128)
       && optHierarchyStr(data, 'name', 200)
       && optHierarchyStr(data, 'nome', 200)
       && optHierarchyStr(data, 'bairro', 200)
       && optHierarchyStr(data, 'cidade', 200)
       && optHierarchyStr(data, 'uf', 20)
       && optHierarchyStr(data, 'proprietarioNome', 200)
       && optHierarchyStr(data, 'proprietarioDocumento', 100)
       && optHierarchyStr(data, 'responsavelTecnicoNome', 200)
       && optHierarchyStr(data, 'responsavelTecnicoRegistro', 100);
   }
   function isValidQuadra(data, id) {
     return reqHierarchyId(data, 'construtoraId')
       && reqHierarchyId(data, 'loteamentoId')
       && (!('id' in data) || (data.id is string && data.id == id))
       && optHierarchyStr(data, 'name', 200)
       && optHierarchyStr(data, 'nome', 200)
       && optHierarchyStr(data, 'logradouroPadrao', 300);
   }
   function isValidQuadraUpdate(data, old, id) {
     return reqHierarchyId(data, 'construtoraId')
       && reqHierarchyId(data, 'loteamentoId')
       && (!('id' in data) || (data.id is string && data.id == id))
       && optHierarchyStrUpdate(data, old, 'name', 200)
       && optHierarchyStrUpdate(data, old, 'nome', 200)
       && optHierarchyStrUpdate(data, old, 'logradouroPadrao', 300);
   }
   function isValidLote(data, id) {
     return reqHierarchyId(data, 'construtoraId')
       && reqHierarchyId(data, 'loteamentoId')
       && reqHierarchyId(data, 'quadraId')
       && (!('id' in data) || (data.id is string && data.id == id))
       && optHierarchyStr(data, 'name', 200)
       && optHierarchyStr(data, 'nome', 200)
       && optHierarchyStr(data, 'numero', 50)
       && optHierarchyStr(data, 'logradouro', 300);
   }
   function isValidLoteUpdate(data, old, id) {
     return reqHierarchyId(data, 'construtoraId')
       && reqHierarchyId(data, 'loteamentoId')
       && reqHierarchyId(data, 'quadraId')
       && (!('id' in data) || (data.id is string && data.id == id))
       && optHierarchyStrUpdate(data, old, 'name', 200)
       && optHierarchyStrUpdate(data, old, 'nome', 200)
       && optHierarchyStrUpdate(data, old, 'numero', 50)
       && optHierarchyStrUpdate(data, old, 'logradouro', 300);
   }
   function isValidEtapa(data, id) {
     return reqHierarchyId(data, 'construtoraId')
       && reqHierarchyId(data, 'loteamentoId')
       && reqHierarchyId(data, 'quadraId')
       && reqHierarchyId(data, 'loteId')
       && (!('id' in data) || (data.id is string && data.id == id))
       && optHierarchyStr(data, 'name', 200)
       && optHierarchyStr(data, 'nome', 200)
       && optHierarchyStr(data, 'equipeId', 128)
       && optHierarchyStr(data, 'equipeNome', 200)
       && optHierarchyStr(data, 'responsavelId', 128);
   }
   function isValidEtapaUpdate(data, old, id) {
     return reqHierarchyId(data, 'construtoraId')
       && reqHierarchyId(data, 'loteamentoId')
       && reqHierarchyId(data, 'quadraId')
       && reqHierarchyId(data, 'loteId')
       && (!('id' in data) || (data.id is string && data.id == id))
       && optHierarchyStrUpdate(data, old, 'name', 200)
       && optHierarchyStrUpdate(data, old, 'nome', 200)
       && optHierarchyStrUpdate(data, old, 'equipeId', 128)
       && optHierarchyStrUpdate(data, old, 'equipeNome', 200)
       && optHierarchyStrUpdate(data, old, 'responsavelId', 128);
   }
   function isValidEquipeLote(data, id) {
     return reqHierarchyId(data, 'construtoraId')
       && reqHierarchyId(data, 'loteamentoId')
       && reqHierarchyId(data, 'quadraId')
       && reqHierarchyId(data, 'loteId')
       && reqHierarchyId(data, 'etapaId')
       && (!('id' in data) || (data.id is string && data.id == id))
       && optHierarchyStr(data, 'name', 200)
       && optHierarchyStr(data, 'nome', 200)
       && optHierarchyStr(data, 'responsavelId', 128);
   }
   function isValidEquipeLoteUpdate(data, old, id) {
     return reqHierarchyId(data, 'construtoraId')
       && reqHierarchyId(data, 'loteamentoId')
       && reqHierarchyId(data, 'quadraId')
       && reqHierarchyId(data, 'loteId')
       && reqHierarchyId(data, 'etapaId')
       && (!('id' in data) || (data.id is string && data.id == id))
       && optHierarchyStrUpdate(data, old, 'name', 200)
       && optHierarchyStrUpdate(data, old, 'nome', 200)
       && optHierarchyStrUpdate(data, old, 'responsavelId', 128);
   }

   function quadraMatchesLoteamentoAfter(data) {
     let lotAfter = getAfter(/databases/$(database)/documents/loteamentos/$(data.loteamentoId));
     return lotAfter != null && lotAfter.data.construtoraId == data.construtoraId;
   }
   function loteMatchesQuadraAfter(data) {
     let quadraAfter = getAfter(/databases/$(database)/documents/quadras/$(data.quadraId));
     return quadraAfter != null
       && quadraAfter.data.construtoraId == data.construtoraId
       && quadraAfter.data.loteamentoId == data.loteamentoId;
   }
   function etapaMatchesLoteAfter(data) {
     let loteAfter = getAfter(/databases/$(database)/documents/lotes/$(data.loteId));
     return loteAfter != null
       && loteAfter.data.construtoraId == data.construtoraId
       && loteAfter.data.loteamentoId == data.loteamentoId
       && loteAfter.data.quadraId == data.quadraId;
   }
   function equipeMatchesEtapa(data) {
     let etapa = get(/databases/$(database)/documents/etapas/$(data.etapaId));
     return etapa != null
       && etapa.data.construtoraId == data.construtoraId
       && etapa.data.loteamentoId == data.loteamentoId
       && etapa.data.quadraId == data.quadraId
       && etapa.data.loteId == data.loteId;
   }

   match /loteamentos/{id} {
     allow get: if (resource == null && signed() && activeUser())
       || hierarchyRead(resource.data.construtoraId)
       || obraMember(resource.data.construtoraId, id)
       || (hasExplicitObraId(resource.data) && obraMember(resource.data.construtoraId, resource.data.obraId));
     allow list: if
       hierarchyRead(resource.data.construtoraId)
       || obraMember(resource.data.construtoraId, id)
       || (hasExplicitObraId(resource.data) && obraMember(resource.data.construtoraId, resource.data.obraId));
     allow create: if isValidLoteamento(request.resource.data, id)
       && admin(request.resource.data.construtoraId);
     allow update: if isValidLoteamento(request.resource.data, id)
       && request.resource.data.construtoraId == resource.data.construtoraId
       && request.resource.data.get('id', id) == resource.data.get('id', id)
       && (
         admin(resource.data.construtoraId)
         || (
           obraOnlyAdmin(resource.data.construtoraId, loteamentoObraId(resource.data, id))
           && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'name', 'nome', 'bairro', 'cidade', 'uf',
             'proprietarioNome', 'proprietarioDocumento',
             'responsavelTecnicoNome', 'responsavelTecnicoRegistro',
             'updatedAt'
           ])
         )
       );
     allow delete: if admin(resource.data.construtoraId);
   }

   match /quadras/{id} {
     allow read: if hierarchyRead(resource.data.construtoraId)
       || hierarchyObraMember(resource.data.construtoraId, resource.data.loteamentoId);
     allow create: if isValidQuadra(request.resource.data, id)
       && hierarchyObraAdmin(request.resource.data.construtoraId, request.resource.data.loteamentoId)
       && quadraMatchesLoteamentoAfter(request.resource.data);
     allow update: if isValidQuadraUpdate(request.resource.data, resource.data, id)
       && hierarchyObraAdmin(resource.data.construtoraId, resource.data.loteamentoId)
       && request.resource.data.construtoraId == resource.data.construtoraId
       && request.resource.data.loteamentoId == resource.data.loteamentoId
       && request.resource.data.get('id', id) == resource.data.get('id', id);
     allow delete: if hierarchyObraAdmin(resource.data.construtoraId, resource.data.loteamentoId);
   }

   match /lotes/{id} {
     allow read: if hierarchyRead(resource.data.construtoraId)
       || hierarchyObraMember(resource.data.construtoraId, resource.data.loteamentoId);
     allow create: if isValidLote(request.resource.data, id)
       && hierarchyObraAdmin(request.resource.data.construtoraId, request.resource.data.loteamentoId)
       && loteMatchesQuadraAfter(request.resource.data);
     allow update: if isValidLoteUpdate(request.resource.data, resource.data, id)
       && hierarchyObraAdmin(resource.data.construtoraId, resource.data.loteamentoId)
       && request.resource.data.construtoraId == resource.data.construtoraId
       && request.resource.data.loteamentoId == resource.data.loteamentoId
       && request.resource.data.quadraId == resource.data.quadraId
       && request.resource.data.get('id', id) == resource.data.get('id', id);
     allow delete: if hierarchyObraAdmin(resource.data.construtoraId, resource.data.loteamentoId);
   }

   match /etapas/{id} {
     allow read: if hierarchyRead(resource.data.construtoraId)
       || hierarchyObraMember(resource.data.construtoraId, resource.data.loteamentoId);
     allow create: if isValidEtapa(request.resource.data, id)
       && hierarchyObraAdmin(request.resource.data.construtoraId, request.resource.data.loteamentoId)
       && etapaMatchesLoteAfter(request.resource.data);
     allow update: if isValidEtapaUpdate(request.resource.data, resource.data, id)
       && hierarchyObraAdmin(resource.data.construtoraId, resource.data.loteamentoId)
       && request.resource.data.construtoraId == resource.data.construtoraId
       && request.resource.data.loteamentoId == resource.data.loteamentoId
       && request.resource.data.quadraId == resource.data.quadraId
       && request.resource.data.loteId == resource.data.loteId
       && request.resource.data.get('id', id) == resource.data.get('id', id);
     allow delete: if hierarchyObraAdmin(resource.data.construtoraId, resource.data.loteamentoId);
   }

   match /equipes/{id} {
     allow read: if hierarchyRead(resource.data.construtoraId)
       || hierarchyObraMember(resource.data.construtoraId, resource.data.loteamentoId);
     allow create: if isValidEquipeLote(request.resource.data, id)
       && hierarchyObraAdmin(request.resource.data.construtoraId, request.resource.data.loteamentoId)
       && equipeMatchesEtapa(request.resource.data);
     allow update: if isValidEquipeLoteUpdate(request.resource.data, resource.data, id)
       && hierarchyObraAdmin(resource.data.construtoraId, resource.data.loteamentoId)
       && request.resource.data.construtoraId == resource.data.construtoraId
       && request.resource.data.loteamentoId == resource.data.loteamentoId
       && request.resource.data.quadraId == resource.data.quadraId
       && request.resource.data.loteId == resource.data.loteId
       && request.resource.data.etapaId == resource.data.etapaId
       && request.resource.data.get('id', id) == resource.data.get('id', id);
     allow delete: if hierarchyObraAdmin(resource.data.construtoraId, resource.data.loteamentoId);
   }

   // Rascunhos de importação (DXF/DWF/PDF): o membro ativo da construtora do rascunho
   // revisa os itens e aprova; criação e exclusão são exclusivas do backend.
   match /loteamentos_drafts/{draft_id} {
     allow read: if member(resource.data.construtoraId);
     allow update: if member(resource.data.construtoraId)
       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
         ['loteamento', 'targetLoteamentoId', 'items', 'status', 'consolidationRequestId', 'updatedAt']
       );
     allow create, delete: if false;
   }
  match /{path=**}/construtora_members/{uid} { allow read: if dev() || (signed() && activeUser() && resource.data.userId == request.auth.uid); }
  match /{path=**}/members/{uid} { allow read: if dev() || (signed() && activeUser() && resource.data.userId == request.auth.uid); }
  match /{path=**}/movimentacoes/{id} { allow read: if dev() || (signed() && activeUser()); }
  // Solicitações de acesso: criadas via Cloud Function (backend); admin da construtora pode ler as suas
  match /access_requests/{reqId} {
    allow read: if dev() || (signed() && activeUser() && (resource.data.requestedBy == request.auth.uid || admin(resource.data.construtoraId)));
    allow write: if dev();
  }
  // Notificações in-app: criadas pelo backend; usuário lê e marca como lida
  match /users/{uid}/notifications/{nId} {
    allow read: if signed() && activeUser() && request.auth.uid == uid;
    allow update: if signed() && activeUser() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    allow write: if dev();
  }

 }
}
