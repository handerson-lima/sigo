rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
   function signed() { return request.auth != null; }
   function dev() { return signed() && exists(/databases/$(database)/documents/dev_roles/$(request.auth.uid)) && get(/databases/$(database)/documents/dev_roles/$(request.auth.uid)).data.get('isActive', false) == true; }
   function cmExists(c) { return signed() && exists(/databases/$(database)/documents/construtoras/$(c)/construtora_members/$(request.auth.uid)); }
   function cm(c) { return get(/databases/$(database)/documents/construtoras/$(c)/construtora_members/$(request.auth.uid)).data; }
   function activeConstrutora(c) { return get(/databases/$(database)/documents/construtoras/$(c)).data.get('isActive', true) == true; }
   function member(c) { return dev() || (cmExists(c) && cm(c).get('isActive', false) == true && activeConstrutora(c)); }
   function admin(c) { return dev() || (member(c) && (cm(c).get('isAdmin', false) == true || cm(c).get('isOwner', false) == true || cm(c).get('role', '') == 'admin' || cm(c).get('role', '') == 'owner')); }
   function omExists(c,o) { return signed() && exists(/databases/$(database)/documents/construtoras/$(c)/obras/$(o)/members/$(request.auth.uid)); }
   function om(c,o) { return get(/databases/$(database)/documents/construtoras/$(c)/obras/$(o)/members/$(request.auth.uid)).data; }
   function obraMember(c,o) { return dev() || (member(c) && omExists(c,o) && om(c,o).get('isActive', false) == true); }
   function obraAdmin(c,o) { return admin(c) || (obraMember(c,o) && (om(c,o).get('isAdmin',false) == true || om(c,o).get('isOwner',false) == true || om(c,o).get('role', '') == 'admin' || om(c,o).get('role', '') == 'owner')); }
   function module(c,o,m) { return obraAdmin(c,o) || (obraMember(c,o) && (m in om(c,o).get('modules',[]) || m == 'diario' && 'rdo' in om(c,o).get('modules',[]) || m == 'estoque' && 'almoxarifado' in om(c,o).get('modules',[]) || m == 'validacao' && 'qualidade' in om(c,o).get('modules',[]) || m == 'adm' && 'financeiro' in om(c,o).get('modules',[]))); }
   function stock(c) { return admin(c) || (member(c) && ('estoque' in cm(c).get('modules',[]) || 'almoxarifado' in cm(c).get('modules',[]))); }
   function rh(c) { return admin(c) || (member(c) && ('rh' in cm(c).get('modules',[]) || 'recursos_humanos' in cm(c).get('modules',[]))); }
   function epi(c) { return admin(c) || (member(c) && ('epi' in cm(c).get('modules',[]))); }
   function validacao(c) { return admin(c) || (member(c) && ('validacao' in cm(c).get('modules',[]) || 'qualidade' in cm(c).get('modules',[]))); }
   function adm(c) { return admin(c) || (member(c) && ('adm' in cm(c).get('modules',[]) || 'financeiro' in cm(c).get('modules',[]))); }

   // Acesso irrestrito total para desenvolvedores globais ativos
   match /{document=**} {
     allow read, write: if dev();
   }
  match /dev_roles/{uid} {
    allow read: if signed() && (request.auth.uid == uid || dev());
    allow create: if signed() && request.auth.uid == uid && (
      (exists(/databases/$(database)/documents/users/$(uid)) && get(/databases/$(database)/documents/users/$(uid)).data.get('globalRole', '') == 'dev') ||
      request.auth.token.email.matches('(?i).*dev.*')
    ) && request.resource.data.get('isActive', false) == true;
    allow update, delete: if dev();
  }
  match /audit/{id} { allow read: if dev(); allow write: if dev(); }
  match /users/{uid} {
   allow read: if signed() && (request.auth.uid == uid || dev());
   allow create: if signed() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['id','email','displayName','photoUrl','createdAt','updatedAt','globalRole']) && request.resource.data.id == uid && request.resource.data.email == request.auth.token.email && request.resource.data.get('globalRole','user') in ['user',null];
   allow update: if signed() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','photoUrl','updatedAt']);
   allow delete: if dev();
  }
  match /construtoras/{c} {
   allow read: if dev() || member(c);
   allow create: if dev() && request.resource.data.id == c;
   allow update: if admin(c) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','cnpj','address','logoUrl','updatedAt']) && (!('logoUrl' in request.resource.data) || request.resource.data.logoUrl == null || request.resource.data.logoUrl is string);
   allow delete: if dev();
   match /construtora_members/{uid} { allow read: if signed() && (request.auth.uid == uid || admin(c)); allow write: if dev(); }
   match /loteamentos/{loteamentoId} {
     allow read: if member(c);
     allow write: if admin(c);
     match /quadras/{quadraId} {
       allow read: if member(c);
       allow write: if admin(c);
       match /lotes/{loteId} {
         allow read: if member(c);
         allow write: if admin(c);
         match /setores/{setorId} {
           allow read: if member(c);
           allow write: if admin(c);
           match /equipes/{equipeId} {
             allow read: if member(c);
             allow write: if admin(c);
           }
         }
       }
     }
   }
   match /commands/{id} { allow read: if dev() || (signed() && resource.data.actor == request.auth.uid); allow write: if dev(); }
   match /funcionarios/{f} {
    allow read: if rh(c);
    allow create, update: if rh(c) && request.resource.data.id == f && request.resource.data.construtoraId == c;
    allow delete: if dev();
   }
   match /equipes/{e} {
    allow read: if rh(c);
    allow create, update: if rh(c) && request.resource.data.id == e && request.resource.data.construtoraId == c;
    allow delete: if dev();
   }
   match /catalogo_epis/{epiId} {
    allow read: if member(c);
    allow create, update: if (admin(c) || epi(c)) && request.resource.data.id == epiId && request.resource.data.construtoraId == c;
    allow delete: if dev();
   }
   match /validacao_templates/{tId} {
    allow read: if member(c);
    allow create, update: if (admin(c) || validacao(c)) && request.resource.data.id == tId && request.resource.data.construtoraId == c;
    allow delete: if dev();
   }
   match /fornecedores/{fId} {
    allow read: if member(c);
    allow create: if (admin(c) || stock(c) || adm(c))
      && request.resource.data.id == fId
      && request.resource.data.construtoraId == c
      && request.resource.data.documento is string
      && (request.resource.data.documento.size() == 11 || request.resource.data.documento.size() == 14)
      && request.resource.data.status in ['ativo', 'inativo'];
    allow update: if (admin(c) || stock(c) || adm(c))
      && request.resource.data.id == fId
      && request.resource.data.construtoraId == c
      && request.resource.data.documento == resource.data.documento
      && request.resource.data.status in ['ativo', 'inativo'];
    allow delete: if dev();
   }
   match /materiais/{m} {
    allow read: if stock(c);
    allow create: if stock(c) && request.resource.data.keys().hasOnly(['id','construtoraId','name','unit','currentQuantity','quantityUnits','quantityScale','schemaVersion']) && request.resource.data.id == m && request.resource.data.construtoraId == c && request.resource.data.currentQuantity == 0 && request.resource.data.quantityUnits == 0 && request.resource.data.quantityScale == 1000 && request.resource.data.schemaVersion == 2;
    allow update: if admin(c) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','unit']);
    allow delete: if dev();
    match /movimentacoes/{id} { allow read: if stock(c); allow write: if dev(); }
   }
   match /despesas/{id} {
    allow read: if admin(c);
    allow create: if admin(c) && request.resource.data.keys().hasOnly(['id','construtoraId','obraId','descricao','valor','valorEmCentavos','dataVencimento','dataPagamento','status','categoria','responsavelId','createdAt','schemaVersion']) && request.resource.data.id == id && request.resource.data.construtoraId == c && request.resource.data.responsavelId == request.auth.uid && request.resource.data.status == 'pendente' && request.resource.data.dataPagamento == null && request.resource.data.valorEmCentavos is int && request.resource.data.valorEmCentavos > 0 && request.resource.data.valorEmCentavos <= 9007199254740991 && request.resource.data.valor == request.resource.data.valorEmCentavos / 100.0 && request.resource.data.schemaVersion == 2 && request.resource.data.dataVencimento is string && request.resource.data.dataVencimento.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && (request.resource.data.obraId == null || exists(/databases/$(database)/documents/construtoras/$(c)/obras/$(request.resource.data.obraId)));
    allow update, delete: if dev();
   }
   match /obras/{o} {
    allow read: if admin(c) || obraMember(c,o);
    allow create: if admin(c) && request.resource.data.id == o && request.resource.data.construtoraId == c;
    allow update: if admin(c) && request.resource.data.id == resource.data.id && request.resource.data.construtoraId == resource.data.construtoraId;
    allow delete: if dev();
    match /members/{uid} { allow read: if signed() && (request.auth.uid == uid || obraAdmin(c,o)); allow write: if dev(); }
    match /lotes/{l} {
     allow read: if module(c,o,'lotes') || module(c,o,'adm') || module(c,o,'financeiro') || obraMember(c,o) || admin(c);
     allow create, update: if obraAdmin(c,o) && request.resource.data.id == l && request.resource.data.obraId == o;
     allow delete: if dev();
     match /validacoes/{v} {
      allow read: if obraMember(c,o) || admin(c);
      allow create, update: if (module(c,o,'validacao') || validacao(c) || obraAdmin(c,o))
        && request.resource.data.id == v
        && request.resource.data.construtoraId == c
        && request.resource.data.obraId == o
        && request.resource.data.loteId == l;
      allow delete: if dev();
     }
     match /resumo_custos/{doc} {
      allow read: if admin(c) || obraMember(c,o);
      allow create, update: if (admin(c) || obraAdmin(c,o) || module(c,o,'adm') || adm(c) || module(c,o,'financeiro') || module(c,o,'rh') || module(c,o,'almoxarifado'));
      allow delete: if dev();
     }
    }
    match /resumo_custos/{doc} {
     allow read: if admin(c) || obraMember(c,o);
     allow create, update: if (admin(c) || obraAdmin(c,o) || module(c,o,'adm') || adm(c) || module(c,o,'financeiro') || module(c,o,'rh') || module(c,o,'almoxarifado'));
     allow delete: if dev();
    }
    match /compras/{compraId} {
     allow read: if admin(c) || obraMember(c,o);
     allow create: if (admin(c) || obraAdmin(c,o) || module(c,o,'compras') || module(c,o,'almoxarifado') || module(c,o,'adm') || adm(c))
       && request.resource.data.id == compraId
       && request.resource.data.construtoraId == c
       && request.resource.data.obraId == o
       && request.resource.data.totalCompraCents is int
       && request.resource.data.totalCompraCents > 0
       && request.resource.data.status in ['aberto', 'parcial', 'pago', 'cancelado'];
     allow update: if (admin(c) || obraAdmin(c,o) || module(c,o,'compras') || module(c,o,'almoxarifado') || module(c,o,'adm') || adm(c))
       && request.resource.data.id == compraId
       && request.resource.data.construtoraId == c
       && request.resource.data.obraId == o
       && request.resource.data.status in ['aberto', 'parcial', 'pago', 'cancelado'];
     allow delete: if dev();
    }
    match /diarios/{id} { allow read: if module(c,o,'diario'); allow write: if dev(); }
    match /chamadas/{ch} {
     allow read: if rh(c) || module(c,o,'rh') || module(c,o,'adm') || module(c,o,'financeiro') || obraAdmin(c,o);
     allow create: if (rh(c) || module(c,o,'rh'))
       && request.resource.data.id == ch
       && request.resource.data.construtoraId == c
       && request.resource.data.obraId == o
       && request.resource.data.schemaVersion == 1
       && (!('totalDayCostCents' in request.resource.data) || (request.resource.data.totalDayCostCents is int && request.resource.data.totalDayCostCents >= 0));
     allow update: if (rh(c) || module(c,o,'rh'))
       && request.resource.data.id == ch
       && request.resource.data.construtoraId == c
       && request.resource.data.obraId == o
       && request.resource.data.schemaVersion == 1
       && (!('totalDayCostCents' in request.resource.data) || (request.resource.data.totalDayCostCents is int && request.resource.data.totalDayCostCents >= 0))
       && (!('status' in resource.data) || (resource.data.status != 'fechada' && resource.data.status != 'confirmada') || request.resource.data.status == 'retificada')
       && (request.resource.data.status != 'retificada' || (request.resource.data.motivoRetificacao is string && request.resource.data.motivoRetificacao.size() >= 10));
     allow delete: if dev();
    }
    match /epi_events/{evId} {
     allow read: if admin(c) || obraMember(c,o);
     allow create, update: if (module(c,o,'epi') || epi(c))
       && request.resource.data.id == evId
       && request.resource.data.construtoraId == c
       && request.resource.data.obraId == o;
     allow delete: if dev();
    }
    match /termos_epi/{tId} {
     allow read: if admin(c) || obraMember(c,o);
     allow create, update: if (module(c,o,'epi') || epi(c))
       && request.resource.data.id == tId
       && request.resource.data.construtoraId == c
       && request.resource.data.obraId == o;
     allow delete: if dev();
    }
    match /despesas_adm/{dId} {
     allow read: if admin(c) || obraMember(c,o);
     allow create: if (admin(c) || obraAdmin(c,o) || module(c,o,'adm') || adm(c))
       && request.resource.data.id == dId
       && request.resource.data.construtoraId == c
       && request.resource.data.obraId == o
       && request.resource.data.valorTotalCents is int
       && request.resource.data.valorTotalCents > 0
       && request.resource.data.status in ['pendente', 'pago', 'atrasado', 'cancelado'];
     allow update: if (admin(c) || obraAdmin(c,o) || module(c,o,'adm') || adm(c))
       && request.resource.data.id == dId
       && request.resource.data.construtoraId == c
       && request.resource.data.obraId == o
       && (resource.data.status != 'pago' || request.resource.data.valorTotalCents == resource.data.valorTotalCents)
       && (request.resource.data.status != 'cancelado' || (request.resource.data.motivoCancelamento is string && request.resource.data.motivoCancelamento.size() >= 10));
     allow delete: if dev();
    }
   }
  }
  match /{path=**}/construtora_members/{uid} { allow read: if dev() || (signed() && resource.data.userId == request.auth.uid); }
  match /{path=**}/members/{uid} { allow read: if dev() || (signed() && resource.data.userId == request.auth.uid); }
  match /{path=**}/movimentacoes/{id} { allow read: if dev() || signed(); }
  // Solicitações de acesso: criadas via Cloud Function (backend); admin da construtora pode ler as suas
  match /access_requests/{reqId} {
    allow read: if dev() || (signed() && (resource.data.requestedBy == request.auth.uid || admin(resource.data.construtoraId)));
    allow write: if dev();
  }
  // Notificações in-app: criadas pelo backend; usuário lê e marca como lida
  match /users/{uid}/notifications/{nId} {
    allow read: if signed() && request.auth.uid == uid;
    allow update: if signed() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    allow write: if dev();
  }

 }
}
