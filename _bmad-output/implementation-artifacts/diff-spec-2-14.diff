+      final metaFile = File('${dir.path}/schema_version.json');
+      final data = {
+        'schema': 'sigo-operations',
+        ...args,
+      };
+      await metaFile.writeAsString(jsonEncode(data), flush: true);
+      return jsonEncode(data);
+    }
     if (action.startsWith('cache')) {
