+      // Verifica Lotes
+      expect(find.text('Lote 01 - Fundações'), findsOneWidget);
+      expect(find.text('Lote 02 - Alvenaria'), findsOneWidget);
+      expect(find.text('No Orçamento'), findsOneWidget);
