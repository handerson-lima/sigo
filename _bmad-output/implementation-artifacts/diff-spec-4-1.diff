+      // Total = 360.000 centavos / 30 = 12.000 centavos = R$ 120,00/dia
+      final dailyCents = Funcionario.calculateDailyRate(
+        salaryBasis: 'mensal',
+        baseSalaryCents: 300000,
+        additionalCostsCents: 60000,
+      );
+      expect(dailyCents, equals(12000));
+
+      final f = Funcionario(
+        id: 'func-01',
+        construtoraId: 'c1',
+        name: 'João da Silva',
+        cpf: validCpf1,
