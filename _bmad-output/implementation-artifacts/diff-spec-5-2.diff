+                      Expanded(
+                        child: Center(
+                          child: Column(
+                            mainAxisAlignment: MainAxisAlignment.center,
+                            children: [
+                              Icon(Icons.checklist, size: 64, color: Colors.grey[400]),
+                              const SizedBox(height: 16),
+                              const Text(
