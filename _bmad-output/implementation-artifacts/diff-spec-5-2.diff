+                                                  : Icons.edit_document),
+                                          color: vistoria.isAprovado
+                                              ? Colors.green[800]
+                                              : (vistoria.isReprovado
+                                                  ? Colors.red[800]
+                                                  : Colors.blue[800]),
+                                        ),
