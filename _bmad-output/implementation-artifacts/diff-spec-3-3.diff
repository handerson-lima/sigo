+        'id': 'mov-legacy-saida',
+        'materialId': 'mat-areia-01',
+        'type': 'saida',
+        'quantity': 5.0,
+        'date': DateTime.now().toIso8601String(),
+        'responsavelId': 'user-antigo',
+        'obraId': 'obra-antiga',
