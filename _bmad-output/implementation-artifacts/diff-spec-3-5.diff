+title: 'Story 3.5 — Estoque: Estorno por Movimentação Inversa'
+type: 'feature'
+created: '2026-09-17'
+status: 'in-progress'
+baseline_commit: 'c09af8e6dbe1123e04df3ee177daf75f04e7e703'
