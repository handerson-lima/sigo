+---
+title: 'Story 2.9 — Endpoints Transacionais'
+type: 'feature'
+created: '2026-09-16'
+status: 'in-progress'
+baseline_commit: 'f2f590564a450bf0b26390b12c5aee4bb71d102c'
+route: 'dispatch'
+review_loop_iteration: 0
+context:
