+import logging
+from shapely.geometry import Point
+
+logger = logging.getLogger(__name__)
+
+STOP_WORDS = ["ÁREA", "AREA", "CASA", "LOTES", "QUADRA", "Q", "RUA", "AV", "AVENIDA"]
+
+def extract_text(entity):
+    """Extrai texto e ponto de inserção de uma entidade ezdxf (TEXT/MTEXT)."""
+    text = ""
+    try:
+        text = str(entity.dxf.text).upper().strip()
+    except AttributeError:
+        # Some entities like ATTRIB or ATTDEF might store text differently
+        pass
+    
+    # Try MTEXT
+    if not text and hasattr(entity, 'text'):
+        text = str(entity.text).upper().strip()
+
+    pt = None
+    try:
+        # Typically insert
+        pt = entity.dxf.insert
+    except AttributeError:
+        pass
+
+    return text, pt
+
+def build_geojson(association, textos, quadra_polygons, lote_polygons):
+    """
+    Constrói um FeatureCollection GeoJSON omitindo Quadras.
+    `association` tem o formato {'quadras': {q_entity: [lote_entities]}, 'lotes_orfaos': [lote_entities]}
+    `textos` é uma lista de ezdxf text entities.
+    `quadra_polygons` mapping q_entity -> shapely Polygon
+    `lote_polygons` mapping lote_entity -> shapely Polygon
+    """
+    
+    # Pre-parse texts
+    parsed_texts = []
+    for txt in textos:
+        val, pt = extract_text(txt)
+        if val and pt:
+            parsed_texts.append((val, Point(pt.x, pt.y)))
+
+    features = []
+
+    def process_lote(lote_entity, q_entity=None):
+        poly = lote_polygons.get(lote_entity)
+        if not poly:
+            return None
+        
+        # Encontra textos contidos no polígono
+        candidates = []
+        for val, pt in parsed_texts:
+            if poly.covers(pt) or poly.contains(pt):
+                # Filtra stop words
+                if val not in STOP_WORDS and not any(sw in val.split() for sw in STOP_WORDS):
+                    candidates.append(val)
+        
+        # Heurística de status
+        status = "ambiguo"
+        nome = ""
+        if len(candidates) == 1:
+            status = "valido"
+            nome = candidates[0]
+        
+        # Se for órfão
+        if q_entity is None:
+            status = "ambiguo"
+        
+        # Quadra name
+        quadra_nome = ""
+        if q_entity is not None:
+            # We could do heuristic on quadra texts too, but for now we just label it with entity handle or see if we find a text
+            # For simplicity, if we need quadra name we try to find it
+            quadra_poly = quadra_polygons.get(q_entity)
+            if quadra_poly:
+                q_candidates = []
+                for val, pt in parsed_texts:
+                    # check if it covers, but texts for quadra might be outside lotes
+                    if quadra_poly.covers(pt):
+                        # crude heuristic: if it has "Q" or "QUADRA"
+                        if "Q" in val or "QUADRA" in val:
+                            q_candidates.append(val)
+                if q_candidates:
+                    quadra_nome = q_candidates[0]
+
+        # Converte Polygon to GeoJSON coordinates
+        # poly.exterior.coords is a sequence of (x,y)
+        coords = [list(poly.exterior.coords)]
+        for interior in poly.interiors:
+            coords.append(list(interior.coords))
+
+        feature = {
+            "type": "Feature",
+            "geometry": {
+                "type": "Polygon",
+                "coordinates": coords
+            },
+            "properties": {
+                "tipo": "lote",
+                "nome": nome,
+                "status": status,
+                "quadra": quadra_nome
+            }
+        }
+        return feature
+
+    for q_entity, lote_list in association['quadras'].items():
+        for lote in lote_list:
+            f = process_lote(lote, q_entity)
+            if f:
+                features.append(f)
+                
+    for lote in association['lotes_orfaos']:
+        f = process_lote(lote, None)
+        if f:
+            features.append(f)
+
+    geojson = {
+        "type": "FeatureCollection",
+        "features": features
+    }
+    return geojson
+
